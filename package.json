{
    "name": "auth-service",
    "version": "1.0.0",
    "description": "the user management service",
    "main": "index.js",
    "scripts": {
        "build": "tsc -p .",
        "start": "node dist/index.js",
        "dev": "tsc-watch --onSuccess \"npm run start\"",
        "format:fix": "npx prettier . --write",
        "format:check": "npx prettier . --check",
        "lint:check": "eslint .",
        "lint:fix": "eslint . --fix",
        "prepare": "husky"
    },
    "keywords": [
        "nodejs",
        "express",
        "microservices",
        "auth-service"
    ],
    "author": "Abhinay Jangde <abhinayjangde@gmail.com>",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "dotenv": "^18.0.4",
        "express": "^5.2.1",
        "http-errors": "^2.0.1",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.6",
        "@types/http-errors": "^2.0.5",
        "@types/node": "^26.6.2",
        "eslint": "^10.11.0",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "lint-staged": "^17.5.1",
        "prettier": "3.9.9",
        "tsc-watch": "^7.2.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.1"
    },
    "lint-staged": {
        "*.{ts}": [
            "npm run format:fix",
            "npm run lint:fix"
        ],
        "*.json": [
            "npm run format:fix"
        ]
    }
}
